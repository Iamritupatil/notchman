{
  "name": "notchman-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node build.mjs",
    "deploy": "npm run bundle && sam deploy",
    "deploy:first": "npm run bundle && sam deploy --guided",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "try": "npm run build && node scripts/try.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
