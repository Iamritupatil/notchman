{
  "name": "notchman",
  "productName": "Notchman",
  "version": "0.1.0",
  "description": "Copy anything, press Alt+T, hear what matters.",
  "author": "Notchman",
  "homepage": "https://notchman.app",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "e2e": "electron --no-sandbox test/e2e/harness.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "linkedom": "^0.18.13",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.notchman.desktop",
    "productName": "Notchman",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/tesseract.js-core/tesseract-core.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-simd.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd.{js,wasm,wasm.js}",
      "!**/*.{md,map,ts}",
      "!**/{test,tests,docs,example,examples}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Notchman-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Notchman"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Notchman-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "Notchman reads the paragraphs on your screen so you can pick one to hear."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/eng/**"
    ],
    "dmg": {
      "title": "Notchman",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamritupatil/notchman.git"
  }
}
