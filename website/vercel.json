    { "source": "/download/mac", "destination": "https://x6clb2pbdxbr55i5sdradcnqw40bmqrt.lambda-url.us-east-1.on.aws/dl/mac", "permanent": false },
    { "source": "/download/mac-intel", "destination": "https://x6clb2pbdxbr55i5sdradcnqw40bmqrt.lambda-url.us-east-1.on.aws/dl/mac-intel", "permanent": false },
